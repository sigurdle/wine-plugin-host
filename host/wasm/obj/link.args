--target=wasm32
-O2
-nostdlib
-Wall
-Wextra
-Werror
-matomics
-mbulk-memory
-msimd128
-Wl,--fatal-warnings
-Wl,--no-entry
-Wl,--import-memory
-Wl,--global-base=851968
-Wl,-z,stack-size=16384
-Wl,--export=__stack_pointer
-Wl,--export=__data_end
-Wl,--export-table
-Wl,--growable-table
-Wl,--shared-memory
-Wl,--max-memory=2216689664
