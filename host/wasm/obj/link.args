--target=wasm32
-O2
-nostdlib
-Wall
-Wextra
-Werror
-matomics
-mbulk-memory
-msimd128
-Wl,--fatal-warnings
-Wl,--no-entry
-Wl,--import-memory
-Wl,--global-base=720896
-Wl,-z,stack-size=16384
-Wl,--export=__stack_pointer
-Wl,--export=__data_end
-Wl,--shared-memory
-Wl,--max-memory=2216427520
obj/user32.o
obj/kernel32.o
obj/codepages.o
obj/arena.o
obj/gdi32.o
obj/monodither.o
obj/drawedge.o
obj/ntpath.o
obj/rasterize.o
obj/vtabledispatch.o
obj/com.o
obj/wic.o
obj/photoshop.o
obj/actions.o
obj/imageservices.o
obj/displaypixels.o
obj/colorservices.o
obj/plugindll.o
obj/aftereffects.o
obj/heap.o
obj/addressspace.o
obj/cxxeh.o
